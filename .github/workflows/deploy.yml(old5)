name: Build, Test, Push and Deploy Docker Image

on:
  push:
    branches:
      - main

permissions:
  id-token: write
  contents: read

env:
  AWS_REGION: eu-central-1
  ECR_REPOSITORY: aws-cicd-devops-lab
  EC2_INSTANCE_ID: i-0b3d29d6fcc04d70c

jobs:

  # ============================================================
  # CI - AUTOMATED TESTS
  # ============================================================
  test:
    name: Run automated tests
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.13"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r app/requirements.txt

      - name: Run pytest
        run: |
          python -m pytest -v


  # ============================================================
  # BUILD + PUSH + DEPLOY
  # Runs only if "test" succeeds
  # ============================================================
  build-and-deploy:
    name: Build, Push and Deploy
    needs: test
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: arn:aws:iam::303974373642:role/GitHubActions-ECR-aws-cicd-devops-lab
          aws-region: ${{ env.AWS_REGION }}

      - name: Login to Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Build Docker image
        env:
          REGISTRY: ${{ steps.login-ecr.outputs.registry }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          docker build -t $REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG .

      - name: Scan Docker image with Trivy
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: '${{ steps.login-ecr.outputs.registry }}/${{ env.ECR_REPOSITORY }}:${{ github.sha }}'
          format: 'table'
          exit-code: '1'
          ignore-unfixed: true
          vuln-type: 'os,library'
          severity: 'CRITICAL,HIGH'

      - name: Tag and push Docker image
        env:
          REGISTRY: ${{ steps.login-ecr.outputs.registry }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          docker tag \
            $REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG \
            $REGISTRY/$ECR_REPOSITORY:latest

          docker push $REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG
          docker push $REGISTRY/$ECR_REPOSITORY:latest

      - name: Deploy to EC2 using AWS Systems Manager
        env:
          REGISTRY: ${{ steps.login-ecr.outputs.registry }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          IMAGE_URI="$REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"

          PARAMETERS=$(jq -n \
            --arg registry "$REGISTRY" \
            --arg image "$IMAGE_URI" \
            '{
              commands: [
                "set -e",
                "echo === Deployment started ===",
                "PREVIOUS_IMAGE=$(docker inspect -f '\''{{.Config.Image}}'\'' cicd-backend 2>/dev/null || true)",
                "echo Previous image: $PREVIOUS_IMAGE",
                ("aws ecr get-login-password --region eu-central-1 | docker login --username AWS --password-stdin " + $registry),
                ("docker pull " + $image),
                "docker rm -f cicd-backend || true",
                ("docker run -d --name cicd-backend --restart unless-stopped -p 3001:3000 " + $image),
                "sleep 5",
                "if curl -fsS http://localhost:3001/health; then echo Deployment healthy; else echo Health check failed; docker logs cicd-backend || true; docker rm -f cicd-backend || true; if [ -n \"$PREVIOUS_IMAGE\" ]; then echo Rolling back to $PREVIOUS_IMAGE; docker run -d --name cicd-backend --restart unless-stopped -p 3001:3000 \"$PREVIOUS_IMAGE\"; sleep 5; curl -fsS http://localhost:3001/health; fi; exit 1; fi",
                "echo === Deployment successful ==="
              ]
            }')

          COMMAND_ID=$(aws ssm send-command \
            --instance-ids "$EC2_INSTANCE_ID" \
            --document-name "AWS-RunShellScript" \
            --comment "Deploy commit $IMAGE_TAG" \
            --parameters "$PARAMETERS" \
            --query "Command.CommandId" \
            --output text)

          echo "SSM Command ID: $COMMAND_ID"

          set +e
          aws ssm wait command-executed \
            --command-id "$COMMAND_ID" \
            --instance-id "$EC2_INSTANCE_ID"
          WAIT_RESULT=$?
          set -e

          echo "=== EC2 STDOUT ==="
          aws ssm get-command-invocation \
            --command-id "$COMMAND_ID" \
            --instance-id "$EC2_INSTANCE_ID" \
            --query "StandardOutputContent" \
            --output text

          echo "=== EC2 STDERR ==="
          aws ssm get-command-invocation \
            --command-id "$COMMAND_ID" \
            --instance-id "$EC2_INSTANCE_ID" \
            --query "StandardErrorContent" \
            --output text

          STATUS=$(aws ssm get-command-invocation \
            --command-id "$COMMAND_ID" \
            --instance-id "$EC2_INSTANCE_ID" \
            --query "Status" \
            --output text)

          echo "Deployment status: $STATUS"

          if [ "$WAIT_RESULT" -ne 0 ] || [ "$STATUS" != "Success" ]; then
            echo "Deployment failed or rollback was triggered"
            exit 1
          fi