services:
  backend:
    build: .
    container_name: cicd-backend
    ports:
      - "3000:3000"
    restart: unless-stopped
    healthcheck:
      test:
        [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://localhost:3000/health')"
        ]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 5s